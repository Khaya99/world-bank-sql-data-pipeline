    <worksheet name='Sheet 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>Electricity Access and Life Expectancy Changes, 2000–2023</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>30 selected countries · Official World Bank data</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Each point represents one country. Changes are calculated as the 2023 value minus the 2000 value. Across the 30 selected countries, larger electricity-access gains tended to accompany larger life-expectancy gains (Pearson r = 0.660). The line shows a linear trend; this association does not establish causation.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='electricity_life_expectancy_changes_2000_2023' name='federated.0061n1s0r97hra1cn624w0k4x0uv' />
          </datasources>
          <datasource-dependencies datasource='federated.0061n1s0r97hra1cn624w0k4x0uv'>
            <column-instance column='[country_name]' derivation='Attribute' name='[attr:country_name:nk]' pivot='key' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Electricity Change Pp' datatype='real' name='[electricity_change_pp]' role='measure' type='quantitative' />
            <column caption='Life Expectancy Change Years' datatype='real' name='[life_expectancy_change_years]' role='measure' type='quantitative' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[electricity_change_pp]' derivation='Sum' name='[sum:electricity_change_pp:qk]' pivot='key' type='quantitative' />
            <column-instance column='[life_expectancy_change_years]' derivation='Sum' name='[sum:life_expectancy_change_years:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0061n1s0r97hra1cn624w0k4x0uv].[sum:electricity_change_pp:qk]' scope='cols' value='Change in electricity access (percentage points)' />
            <format attr='title' class='0' field='[federated.0061n1s0r97hra1cn624w0k4x0uv].[sum:life_expectancy_change_years:qk]' scope='rows' value='Change in life expectancy (years)' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
